 from invoicing.rates import DISCOUNT_CODES, TAX_RATES
 
 
+# tiers: 10 or more units, 50 or more units
+def _quantity_discount(quantity: int) -> Decimal:
+    if quantity >= 50:
+        return Decimal("0.10")
+    if quantity >= 10:
+        return Decimal("0.05")
+    return Decimal("0")
+
