 from invoicing.rates import DISCOUNT_CODES, TAX_RATES
 
 
+# (minimum quantity, discount rate), highest tier first.
+QUANTITY_DISCOUNTS = (
+    (50, Decimal("0.10")),
+    (10, Decimal("0.05")),
+)
+
+
+def quantity_discount_rate(quantity: int) -> Decimal:
+    for minimum, rate in QUANTITY_DISCOUNTS:
+        if quantity >= minimum:
+            return rate
+    return Decimal("0")
+
+
 def line_total(line: LineItem) -> Decimal:
-    return round_cents(line.unit_price * line.quantity)
+    """Unit price times quantity, less the quantity discount, rounded once."""
+    gross = line.unit_price * line.quantity
+    return round_cents(gross * (1 - quantity_discount_rate(line.quantity)))
 
 
 def subtotal(invoice: Invoice) -> Decimal:
