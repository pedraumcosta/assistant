+def test_merge_lines_combines_same_sku_and_price():
+    merged = merge_lines([line(2, "5.00"), line(3, "5.00")])
+    assert merged == (line(5, "5.00"),)
+
+
+def test_merge_lines_keeps_first_description():
+    merged = merge_lines([
+        line(1, "5.00", description="First"),
+        line(1, "5.00", description="Second"),
+    ])
+    assert len(merged) == 1
+    assert merged[0].description == "First"
+    assert merged[0].quantity == 2
+
+
+def test_merge_lines_different_price_stays_separate():
+    a, b = line(1, "5.00"), line(1, "6.00")
+    assert merge_lines([a, b]) == (a, b)
+
+
+def test_merge_lines_different_sku_stays_separate():
+    a, b = line(1, "5.00", sku="A"), line(1, "5.00", sku="B")
+    assert merge_lines([a, b]) == (a, b)
+
+
+def test_merge_lines_order_of_first_appearance():
+    result = merge_lines([
+        line(1, "5.00", sku="A"),
+        line(1, "5.00", sku="B"),
+        line(1, "6.00", sku="A"),
+        line(2, "5.00", sku="A"),
+        line(1, "5.00", sku="B"),
+    ])
+    assert [(l.sku, l.unit_price, l.quantity) for l in result] == [
+        ("A", Decimal("5.00"), 3),
+        ("B", Decimal("5.00"), 2),
