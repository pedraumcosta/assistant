 def line_total(line: LineItem) -> Decimal:
-    return round_cents(line.unit_price * line.quantity)
+    """Unit price times quantity, less any quantity discount, rounded to cents."""
+    amount = line.unit_price * line.quantity
+    for minimum, rate in QUANTITY_DISCOUNTS:
+        if line.quantity >= minimum:
+            amount -= amount * rate
+            break
+    return round_cents(amount)
 
 
