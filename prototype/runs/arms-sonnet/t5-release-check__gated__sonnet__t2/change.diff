+
+
+def test_long_description_is_truncated_with_ellipsis():
+    from datetime import date
+    from decimal import Decimal
+    from invoicing.models import Invoice, LineItem
+    from invoicing.render import render_text
+
+    line = LineItem("W-1", "Extended warranty, three years, on-site", 2, Decimal("9.99"))
+    text = render_text(Invoice("INV-1", "Acme", date(2026, 10, 5), (line,)))
+    assert "  2 x Extended warranty...      19.98" in text.splitlines()
+    assert all(len(r) <= 37 for r in text.splitlines())
