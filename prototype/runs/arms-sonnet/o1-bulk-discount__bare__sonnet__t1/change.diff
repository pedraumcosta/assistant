+
+
+@pytest.mark.parametrize(
+    "quantity, expected",
+    [
+        (1, "1000.00"),
+        (9, "9000.00"),
+        (10, "9500.00"),
+        (49, "46550.00"),
+        (50, "45000.00"),
+        (100, "90000.00"),
+    ],
+)
+def test_line_total_quantity_discount_tiers(quantity, expected):
+    assert line_total(line(quantity, "1000.00")) == Decimal(expected)
+
+
+def test_line_total_quantity_discount_is_rounded_once_on_line_total():
+    # 10 * 1.99 = 19.90; 5% off = 18.905 -> half-even rounds to 18.90
+    assert line_total(line(10, "1.99")) == Decimal("18.90")
+    # 10 * 0.01 = 0.10; 5% off = 0.095 -> 0.10
+    assert line_total(line(10, "0.01")) == Decimal("0.10")
+
+
+def test_subtotal_uses_discounted_line_totals():
+    assert subtotal(invoice(line(10, "10.00"), line(1, "5.00"))) == Decimal("100.00")
