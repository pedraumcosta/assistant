+@pytest.mark.parametrize(
+    "quantity, expected",
+    [
+        (1, "10.00"),
+        (9, "90.00"),
+        (10, "95.00"),
+        (49, "465.50"),
+        (50, "450.00"),
+        (100, "900.00"),
+    ],
+)
+def test_line_total_quantity_discount(quantity, expected):
+    assert line_total(line(quantity, "10.00")) == Decimal(expected)
+
+
+def test_line_total_quantity_discount_rounds_half_even():
+    # 10 * 0.25 * 0.95 = 2.375 -> 2.38 (half-even, 7 is odd -> up)
+    assert line_total(line(10, "0.25")) == Decimal("2.38")
+    # 10 * 0.15 * 0.95 = 1.425 -> 1.42 (half-even)
+    assert line_total(line(10, "0.15")) == Decimal("1.42")
+
+
+def test_subtotal_uses_discounted_line_totals():
