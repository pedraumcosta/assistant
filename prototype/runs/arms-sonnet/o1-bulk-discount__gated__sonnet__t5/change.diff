 from invoicing.rates import DISCOUNT_CODES, TAX_RATES
 
 
+def _quantity_rate(quantity: int) -> Decimal:
+    """Fraction taken off a line for its quantity."""
+    if quantity >= 50:
+        return Decimal("0.10")
+    if quantity >= 10:
+        return Decimal("0.05")
+    return Decimal("0")
+
+
 def line_total(line: LineItem) -> Decimal:
-    return round_cents(line.unit_price * line.quantity)
+    gross = line.unit_price * line.quantity
+    return round_cents(gross * (1 - _quantity_rate(line.quantity)))
 
 
 def subtotal(invoice: Invoice) -> Decimal:
