--- a/tests/test_store_list_numbers.py
+++ b/tests/test_store_list_numbers.py
@@ -0,0 +1,20 @@
+from invoicing.store import list_numbers, save
+from tests.helpers import invoice, line
+
+
+def test_list_numbers_sorted(tmp_path):
+    for n in ("INV-0003", "INV-0001", "INV-0002"):
+        save(invoice(line(1, "1.00"), number=n), tmp_path)
+    assert list_numbers(tmp_path) == ["INV-0001", "INV-0002", "INV-0003"]
+
+
+def test_list_numbers_ignores_non_json(tmp_path):
+    save(invoice(line(1, "1.00"), number="INV-0001"), tmp_path)
+    (tmp_path / "notes.txt").write_text("x")
+    (tmp_path / "INV-0002.json.bak").write_text("x")
+    (tmp_path / "subdir.json").mkdir()
+    assert list_numbers(tmp_path) == ["INV-0001"]
+
+
+def test_list_numbers_empty_directory(tmp_path):
+    assert list_numbers(tmp_path) == []
