+def list_numbers(directory: Path) -> list[str]:
+    """Return the sorted numbers of the invoices saved in `directory`.
+
+    Only regular files with a `.json` suffix are considered.
+    """
+    directory = Path(directory)
+    if not directory.is_dir():
+        return []
+    return sorted(p.stem for p in directory.iterdir()
+                  if p.suffix == ".json" and p.is_file())
+
