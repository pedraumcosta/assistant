+def list_numbers(directory: Path) -> list[str]:
+    """Numbers of the invoices saved in the directory, sorted. Non-.json files are ignored."""
+    directory = Path(directory)
+    if not directory.is_dir():
+        return []
+    return sorted(p.stem for p in directory.iterdir() if p.is_file() and p.suffix == ".json")
+
