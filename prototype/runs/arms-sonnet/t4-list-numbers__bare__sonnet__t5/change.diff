+def test_list_numbers_sorted(tmp_path):
+    for n in ("INV-2026-0003", "INV-2026-0001", "INV-2026-0002"):
+        save(invoice(line(), number=n), tmp_path)
+    assert list_numbers(tmp_path) == ["INV-2026-0001", "INV-2026-0002", "INV-2026-0003"]
+
+
+def test_list_numbers_ignores_non_json(tmp_path):
+    save(invoice(line()), tmp_path)
+    (tmp_path / "notes.txt").write_text("hi")
+    (tmp_path / "INV-2026-0009.json.bak").write_text("{}")
+    (tmp_path / "subdir.json").mkdir()
+    assert list_numbers(tmp_path) == ["INV-2026-0001"]
+
+
+def test_list_numbers_empty_or_missing(tmp_path):
+    assert list_numbers(tmp_path) == []
+    assert list_numbers(tmp_path / "missing") == []
