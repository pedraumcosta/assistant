+
+
+@pytest.mark.parametrize("text, expected", [
+    ("1,234.50", "1234.50"),
+    ("1,234", "1234"),
+    ("12,345.678", "12345.678"),
+    ("123,456,789.01", "123456789.01"),
+    (" 1,000 ", "1000"),
+    ("-1,234.50", "-1234.50"),
+    ("+1,234", "1234"),
+])
+def test_parse_amount_thousands_separators(text, expected):
+    result = parse_amount(text)
+    assert result == Decimal(expected)
+    assert result.as_tuple() == Decimal(expected).as_tuple()
+
+
+@pytest.mark.parametrize("text", [
+    ",", ",234", "1,", "1,23", "1,2345", "1234,567", "1,234,56",
+    "1,,234", "1,234,", "12,34.50", "1.234,50", "1,234.5,6",
+    "1,234,.50", "1, 234", "1,234e3", "0,12", "abc,123", "1,234.5.6",
+])
+def test_parse_amount_rejects_malformed_commas(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+def test_parse_amount_without_commas_unchanged():
+    assert parse_amount("1234.50") == Decimal("1234.50")
