+
+def test_merge_lines_combines_same_sku_and_price():
+    a = line(2, "9.99", "A", "First")
+    b = line(3, "9.99", "A", "Second")
+    assert merge_lines([a, b]) == (line(5, "9.99", "A", "First"),)
+
+
+def test_merge_lines_different_price_stays_separate():
+    a = line(1, "9.99", "A")
+    b = line(1, "8.99", "A")
+    assert merge_lines([a, b]) == (a, b)
+
+
+def test_merge_lines_order_of_first_appearance():
+    a = line(1, "1.00", "A")
+    b = line(1, "2.00", "B")
+    c = line(4, "1.00", "A")
+    d = line(2, "2.00", "B")
+    assert merge_lines([a, b, c, d]) == (line(5, "1.00", "A"), line(3, "2.00", "B"))
+
+
+def test_merge_lines_equal_prices_with_different_scale():
+    assert merge_lines([line(1, "10.0"), line(2, "10.00")])[0].quantity == 3
+
+
+def test_merge_lines_returns_tuple_and_does_not_mutate():
+    lines = [line(1), line(1)]
+    result = merge_lines(lines)
+    assert isinstance(result, tuple)
+    assert len(lines) == 2 and lines[0].quantity == 1
+    assert merge_lines([]) == ()
