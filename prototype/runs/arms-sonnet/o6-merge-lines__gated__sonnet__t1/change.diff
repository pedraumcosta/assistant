 """Line totals, subtotal, discount, tax and total."""
+from dataclasses import replace
 from decimal import Decimal
+from typing import Iterable
 
 from invoicing.models import Invoice, LineItem
 from invoicing.money import round_cents
 from invoicing.rates import DISCOUNT_CODES, TAX_RATES
+
+
+def merge_lines(lines: Iterable[LineItem]) -> tuple[LineItem, ...]:
+    """Combine lines with the same SKU and unit price, adding quantities.
+
+    A merged line keeps the description of the first line; order follows the
+    first appearance of each (SKU, unit price) pair.
+    """
+    merged: dict[tuple[str, Decimal], LineItem] = {}
+    for item in lines:
+        key = (item.sku, item.unit_price)
+        if key in merged:
+            first = merged[key]
+            merged[key] = replace(first, quantity=first.quantity + item.quantity)
+        else:
+            merged[key] = item
+    return tuple(merged.values())
 
 
