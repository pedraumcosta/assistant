--- a/invoicing/pricing.py
+++ b/invoicing/pricing.py
@@ -6,8 +6,21 @@
 from invoicing.rates import DISCOUNT_CODES, TAX_RATES
 
 
+# (minimum quantity, discount rate), checked from the largest tier down.
+QUANTITY_TIERS = (
+    (50, Decimal("0.10")),
+    (10, Decimal("0.05")),
+)
+
+
 def line_total(line: LineItem) -> Decimal:
-    return round_cents(line.unit_price * line.quantity)
+    """Unit price times quantity, less any quantity discount, in cents."""
+    amount = line.unit_price * line.quantity
+    for minimum, rate in QUANTITY_TIERS:
+        if line.quantity >= minimum:
+            amount -= amount * rate
+            break
+    return round_cents(amount)
 
 
 def subtotal(invoice: Invoice) -> Decimal:
