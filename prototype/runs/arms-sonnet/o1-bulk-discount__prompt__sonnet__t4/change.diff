+
+def test_line_total_no_quantity_discount_below_10():
+    assert line_total(line(9, "10.00")) == Decimal("90.00")
+
+
+def test_line_total_5_percent_at_10():
+    assert line_total(line(10, "10.00")) == Decimal("95.00")
+
+
+def test_line_total_5_percent_at_49():
+    assert line_total(line(49, "10.00")) == Decimal("465.50")
+
+
+def test_line_total_10_percent_at_50():
+    assert line_total(line(50, "10.00")) == Decimal("450.00")
+
+
+def test_line_total_10_percent_above_50():
+    assert line_total(line(100, "10.00")) == Decimal("900.00")
+
+
+def test_line_total_discount_rounds_once_half_even():
+    # 10 * 0.25 = 2.50, less 5% = 2.375 -> tie, half-even gives 2.38
+    assert line_total(line(10, "0.25")) == Decimal("2.38")
+    # 10 * 0.05 = 0.50, less 5% = 0.475 -> tie, half-even gives 0.48
+    assert line_total(line(10, "0.05")) == Decimal("0.48")
+    # 10 * 0.01 = 0.10, less 5% = 0.095 -> tie, half-even gives 0.10
+    assert line_total(line(10, "0.01")) == Decimal("0.10")
+
+
+def test_subtotal_uses_quantity_discount():
+    assert subtotal(invoice(line(10, "10.00"), line(1, "5.00"))) == Decimal("100.00")
