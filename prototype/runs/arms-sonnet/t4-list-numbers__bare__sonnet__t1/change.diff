+def test_list_numbers_sorted(tmp_path):
+    from invoicing.store import list_numbers
+    invs = [invoice(line(1, "1.00"), number=n) for n in ("INV-2", "INV-1", "INV-3")]
+    for inv in invs:
+        save(inv, tmp_path)
+    assert list_numbers(tmp_path) == ["INV-1", "INV-2", "INV-3"]
+
+
+def test_list_numbers_ignores_non_json(tmp_path):
+    from invoicing.store import list_numbers
+    save(invoice(line(1, "1.00"), number="INV-1"), tmp_path)
+    (tmp_path / "notes.txt").write_text("x")
+    (tmp_path / "INV-9.json.bak").write_text("x")
+    (tmp_path / "subdir.json").mkdir()
+    assert list_numbers(tmp_path) == ["INV-1"]
+
+
+def test_list_numbers_empty(tmp_path):
+    from invoicing.store import list_numbers
+    assert list_numbers(tmp_path) == []
