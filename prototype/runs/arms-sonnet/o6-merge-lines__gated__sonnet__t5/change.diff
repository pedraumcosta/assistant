+
+def test_merge_lines_combines_same_sku_and_price():
+    merged = merge_lines([line(2, "5.00"), line(3, "5.00")])
+    assert merged == (line(5, "5.00"),)
+
+
+def test_merge_lines_keeps_first_description():
+    merged = merge_lines([line(1, description="First"), line(1, description="Second")])
+    assert len(merged) == 1
+    assert merged[0].description == "First"
+    assert merged[0].quantity == 2
+
+
+def test_merge_lines_keeps_first_appearance_order():
+    a1 = line(1, "1.00", sku="A")
+    b = line(1, "1.00", sku="B")
+    a2 = line(4, "1.00", sku="A")
+    assert merge_lines([a1, b, a2]) == (line(5, "1.00", sku="A"), b)
+
+
+def test_merge_lines_different_price_stays_separate():
+    lines = [line(1, "5.00"), line(1, "6.00"), line(2, "5.00")]
+    assert merge_lines(lines) == (line(3, "5.00"), line(1, "6.00"))
+
+
+def test_merge_lines_equal_prices_with_different_scale_merge():
+    merged = merge_lines([line(1, "5.0"), line(1, "5.00")])
+    assert len(merged) == 1
+    assert merged[0].quantity == 2
+
+
+def test_merge_lines_returns_tuple_and_does_not_mutate_input():
+    lines = [line(1), line(2)]
+    result = merge_lines(lines)
+    assert isinstance(result, tuple)
+    assert [l.quantity for l in lines] == [1, 2]
+
+
+def test_merge_lines_empty():
+    assert merge_lines([]) == ()
