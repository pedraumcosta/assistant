 """Plain-text rendering of an invoice."""
 from invoicing.models import Invoice
-from invoicing.pricing import line_total, total
+from invoicing.pricing import discount, line_total, subtotal, tax, total
 
 
 def render_text(invoice: Invoice) -> str:
@@ -13,5 +13,12 @@
     for line in invoice.lines:
         out.append(f"{line.quantity:>3} x {line.description:<20} {line_total(line):>10}")
     out.append("")
+    out.append(f"{'Subtotal':<26} {subtotal(invoice):>10}")
+    if invoice.discount_code is not None:
+        label = f"Discount ({invoice.discount_code})"
+        out.append(f"{label:<26} {-discount(invoice):>10}")
+    invoice_tax = tax(invoice)
+    if invoice_tax != 0:
+        out.append(f"{'Tax':<26} {invoice_tax:>10}")
     out.append(f"{'Total':<26} {total(invoice):>10}")
     return "\n".join(out) + "\n"
--- a/tests/test_render.py
+++ b/tests/test_render.py
@@ -12,3 +12,41 @@
         "  2 x Widget                    19.98\n"
     )
     assert text.endswith("Total                           19.98\n")
+
+
+def test_subtotal_line_above_total_without_discount_or_tax():
+    text = render_text(invoice(line(2, "9.99")))
+    assert text.endswith(
+        "Subtotal                        19.98\n"
+        "Total                           19.98\n"
+    )
+    assert "Discount" not in text
+    assert "Tax" not in text
+
+
+def test_discount_line_is_negative():
+    text = render_text(invoice(line(1, "100.00"), discount_code="WELCOME10"))
+    assert text.endswith(
+        "Subtotal                       100.00\n"
+        "Discount (WELCOME10)           -10.00\n"
+        "Total                           90.00\n"
+    )
+
+
+def test_tax_line():
+    text = render_text(invoice(line(1, "100.00"), region="UK"))
+    assert text.endswith(
+        "Subtotal                       100.00\n"
+        "Tax                             20.00\n"
+        "Total                          120.00\n"
+    )
+
+
+def test_subtotal_discount_tax_in_order():
+    text = render_text(invoice(line(1, "200.00"), region="UK", discount_code="PARTNER25"))
+    assert text.endswith(
+        "Subtotal                       200.00\n"
+        "Discount (PARTNER25)           -50.00\n"
+        "Tax                             30.00\n"
+        "Total                          180.00\n"
+    )
