--- a/invoicing/numbering.py
+++ b/invoicing/numbering.py
@@ -1,4 +1,8 @@
 """Invoice numbers, in the form INV-<year>-<sequence>."""
+
+import re
+
+_PATTERN = re.compile(r"INV-([0-9]{4})-([0-9]{4,})")
 
 
 def format_number(year: int, sequence: int) -> str:
@@ -7,4 +11,11 @@
 
 def next_number(existing: list[str], year: int) -> str:
     """The next invoice number for the year, given the numbers already used."""
-    return format_number(year, len(existing) + 1)
+    highest = 0
+    for entry in existing:
+        if not isinstance(entry, str):
+            continue
+        match = _PATTERN.fullmatch(entry)
+        if match and int(match.group(1)) == year:
+            highest = max(highest, int(match.group(2)))
+    return format_number(year, highest + 1)
--- a/tests/test_numbering.py
+++ b/tests/test_numbering.py
@@ -7,3 +7,31 @@
 
 def test_next_number():
     assert next_number(["INV-2026-0001", "INV-2026-0002"], 2026) == "INV-2026-0003"
+
+
+def test_gaps_use_highest():
+    assert next_number(["INV-2026-0001", "INV-2026-0005"], 2026) == "INV-2026-0006"
+
+
+def test_unordered():
+    assert next_number(["INV-2026-0007", "INV-2026-0002"], 2026) == "INV-2026-0008"
+
+
+def test_other_years_ignored():
+    existing = ["INV-2025-0009", "INV-2026-0002", "INV-2027-0050"]
+    assert next_number(existing, 2026) == "INV-2026-0003"
+
+
+def test_none_for_year():
+    assert next_number(["INV-2025-0009"], 2026) == "INV-2026-0001"
+
+
+def test_invalid_entries_ignored():
+    existing = ["garbage", "", "INV-2026-", "INV-2026-abc", "XINV-2026-0099",
+                "INV-2026-0099x", "INV-2026-0003", "inv-2026-0050", "INV-2026-0004-1"]
+    assert next_number(existing, 2026) == "INV-2026-0004"
+
+
+def test_wider_than_four_digits():
+    assert next_number(["INV-2026-9999"], 2026) == "INV-2026-10000"
+    assert next_number(["INV-2026-12345"], 2026) == "INV-2026-12346"
