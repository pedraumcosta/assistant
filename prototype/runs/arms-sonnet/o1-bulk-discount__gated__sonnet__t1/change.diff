+@pytest.mark.parametrize(
+    "quantity, expected",
+    [
+        (9, "90.00"),
+        (10, "95.00"),
+        (49, "465.50"),
+        (50, "450.00"),
+        (100, "900.00"),
+    ],
+)
+def test_line_total_quantity_discount(quantity, expected):
+    assert line_total(line(quantity, "10.00")) == Decimal(expected)
+
+
+def test_line_total_quantity_discount_rounds_half_even():
+    # 10 x 0.05 = 0.50, less 5% = 0.475 -> 0.48 (half-even)
+    assert line_total(line(10, "0.05")) == Decimal("0.48")
+    # 10 x 0.25 = 2.50, less 5% = 2.375 -> 2.38
+    assert line_total(line(10, "0.25")) == Decimal("2.38")
+    # 50 x 0.05 = 2.50, less 10% = 2.25
+    assert line_total(line(50, "0.05")) == Decimal("2.25")
+
+
+def test_subtotal_uses_discounted_line_totals():
+    assert subtotal(invoice(line(10, "10.00"), line(1, "5.00"))) == Decimal("100.00")
