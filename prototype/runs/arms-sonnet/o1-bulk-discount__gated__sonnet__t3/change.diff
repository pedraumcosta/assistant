+@pytest.mark.parametrize(
+    "quantity, expected",
+    [
+        (1, "10.00"),
+        (9, "90.00"),
+        (10, "95.00"),
+        (49, "465.50"),
+        (50, "450.00"),
+        (100, "900.00"),
+    ],
+)
+def test_line_total_quantity_discount_tiers(quantity, expected):
+    assert line_total(line(quantity, "10.00")) == Decimal(expected)
+
+
+def test_line_total_quantity_discount_rounds_once_half_even():
+    # 10 * 0.25 = 2.50; 5% off = 2.375 -> 2.38 (half-even)
+    assert line_total(line(10, "0.25")) == Decimal("2.38")
+    # 10 * 0.85 = 8.50; 5% off = 8.075 -> 8.08 (half-even)
+    assert line_total(line(10, "0.85")) == Decimal("8.08")
+    # 10 * 0.05 = 0.50; 5% off = 0.475 -> 0.48
+    assert line_total(line(10, "0.05")) == Decimal("0.48")
+
+
+def test_subtotal_uses_discounted_line_totals():
+    assert subtotal(invoice(line(10, "10.00"), line(1, "5.00"))) == Decimal("100.00")
