+def test_parse_amount_thousands_separators():
+    assert parse_amount("1,234.50") == Decimal("1234.50")
+    assert parse_amount("1,234") == Decimal("1234")
+    assert parse_amount("12,345,678.9") == Decimal("12345678.9")
+    assert parse_amount(" 999,999.99 ") == Decimal("999999.99")
+    assert parse_amount("-1,234.50") == Decimal("-1234.50")
+
+
+def test_parse_amount_keeps_scale_with_separators():
+    assert str(parse_amount("1,000.00")) == "1000.00"
+
+
+@pytest.mark.parametrize("bad", [
