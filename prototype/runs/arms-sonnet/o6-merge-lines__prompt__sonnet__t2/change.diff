+def test_merge_lines_adds_quantities_and_keeps_first_description():
+    merged = merge_lines([line(2, "5.00", "A", "First"), line(3, "5.00", "A", "Second")])
+    assert merged == (line(5, "5.00", "A", "First"),)
+
+
+def test_merge_lines_keeps_first_appearance_order():
+    a, b = line(1, "1.00", "A"), line(1, "2.00", "B")
+    merged = merge_lines([a, b, line(4, "1.00", "A")])
+    assert merged == (line(5, "1.00", "A"), b)
+
+
+def test_merge_lines_same_sku_different_price_stay_separate():
+    merged = merge_lines([line(1, "5.00", "A"), line(1, "6.00", "A"), line(2, "5.00", "A")])
+    assert merged == (line(3, "5.00", "A"), line(1, "6.00", "A"))
+
+
+def test_merge_lines_equal_prices_with_different_scale_merge():
+    assert len(merge_lines([line(1, "5.0", "A"), line(1, "5.00", "A")])) == 1
+
+
+def test_merge_lines_returns_tuple_and_does_not_mutate_input():
+    original = [line(1, "5.00", "A"), line(1, "5.00", "A")]
+    result = merge_lines(original)
+    assert isinstance(result, tuple)
+    assert len(original) == 2 and original[0].quantity == 1
+
+
+def test_merge_lines_empty():
+    assert merge_lines([]) == ()
