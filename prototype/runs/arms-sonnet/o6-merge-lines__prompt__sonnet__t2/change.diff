@@ -1,4 +1,5 @@
 """Line totals, subtotal, discount, tax and total."""
+from dataclasses import replace
 from decimal import Decimal
 
 from invoicing.models import Invoice, LineItem
@@ -31,3 +32,20 @@
 
 def total(invoice: Invoice) -> Decimal:
     return subtotal(invoice) - discount(invoice) + tax(invoice)
+
+
+def merge_lines(lines) -> tuple[LineItem, ...]:
+    """Combine lines with the same SKU and unit price, adding their quantities.
+
+    A merged line keeps the description of the first line in its group, and
+    merged lines keep the order in which their (SKU, price) first appears.
+    """
+    merged: dict[tuple[str, Decimal], LineItem] = {}
+    for item in lines:
+        key = (item.sku, item.unit_price)
+        if key in merged:
+            first = merged[key]
+            merged[key] = replace(first, quantity=first.quantity + item.quantity)
+        else:
+            merged[key] = item
+    return tuple(merged.values())
