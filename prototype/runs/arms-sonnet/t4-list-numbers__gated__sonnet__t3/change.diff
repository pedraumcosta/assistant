+def list_numbers(directory: Path) -> list:
+    """Return the sorted numbers of the invoices saved in ``directory``."""
+    directory = Path(directory)
+    if not directory.is_dir():
+        return []
+    return sorted(
+        p.stem for p in directory.iterdir()
+        if p.is_file() and p.suffix == ".json"
+    )
+
