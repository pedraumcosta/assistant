--- a/invoicing/terms.py
+++ b/invoicing/terms.py
@@ -3,5 +3,13 @@
 
 
 def due_date(issued: date, terms_days: int = 30) -> date:
-    """The date payment is due."""
-    return issued + timedelta(days=terms_days)
+    """The date payment is due.
+
+    A due date never falls on a weekend: a Saturday or Sunday result
+    is moved to the following Monday.
+    """
+    due = issued + timedelta(days=terms_days)
+    weekday = due.weekday()  # Monday=0 ... Saturday=5, Sunday=6
+    if weekday >= 5:
+        due += timedelta(days=7 - weekday)
+    return due
--- a/tests/test_terms.py
+++ b/tests/test_terms.py
@@ -9,3 +9,26 @@
 
 def test_due_date_custom_terms():
     assert due_date(date(2026, 1, 5), terms_days=14) == date(2026, 1, 19)
+
+
+def test_due_date_saturday_moves_to_monday():
+    # 2026-01-10 is a Saturday
+    assert due_date(date(2026, 1, 3), terms_days=7) == date(2026, 1, 12)
+
+
+def test_due_date_sunday_moves_to_monday():
+    # 2026-01-11 is a Sunday
+    assert due_date(date(2026, 1, 4), terms_days=7) == date(2026, 1, 12)
+
+
+def test_due_date_friday_unchanged():
+    assert due_date(date(2026, 1, 9), terms_days=0) == date(2026, 1, 9)
+
+
+def test_due_date_monday_unchanged():
+    assert due_date(date(2026, 1, 12), terms_days=0) == date(2026, 1, 12)
+
+
+def test_due_date_result_is_never_weekend():
+    for offset in range(60):
+        assert due_date(date(2026, 1, 1), terms_days=offset).weekday() < 5
