+
+def test_line_total_no_discount_below_10():
+    assert line_total(line(9, "10.00")) == Decimal("90.00")
+
+
+def test_line_total_5_percent_at_10():
+    assert line_total(line(10, "10.00")) == Decimal("95.00")
+
+
+def test_line_total_5_percent_at_49():
+    assert line_total(line(49, "10.00")) == Decimal("465.50")
+
+
+def test_line_total_10_percent_at_50():
+    assert line_total(line(50, "10.00")) == Decimal("450.00")
+
+
+def test_line_total_discount_rounds_half_even():
+    # 10 * 0.25 * 0.95 = 2.375 -> 2.38 (half-even)
+    assert line_total(line(10, "0.25")) == Decimal("2.38")
+    # 10 * 0.35 * 0.95 = 3.325 -> 3.32 (half-even)
+    assert line_total(line(10, "0.35")) == Decimal("3.32")
+
+
+def test_subtotal_uses_discounted_lines():
+    assert subtotal(invoice(line(10, "10.00"), line(1, "5.00"))) == Decimal("100.00")
