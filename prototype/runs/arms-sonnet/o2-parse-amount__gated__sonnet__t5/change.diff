 def parse_amount(text: str) -> Decimal:
     """Parse an amount written as text. Raises ValueError if it is not one."""
+    text = text.strip()
+    if "," in text:
+        m = _GROUPED.fullmatch(text)
+        if m is None:
+            raise ValueError(f"not an amount: {text!r}")
+        sign, whole, frac = m.groups()
