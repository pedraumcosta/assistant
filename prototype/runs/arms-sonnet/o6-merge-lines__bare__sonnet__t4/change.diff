+
+def test_merge_lines_adds_quantities_and_keeps_first_description():
+    merged = merge_lines([
+        line(2, "10.00", "W-1", "Widget"),
+        line(3, "10.00", "W-1", "Widget (renamed)"),
+    ])
+    assert merged == (line(5, "10.00", "W-1", "Widget"),)
+
+
+def test_merge_lines_keeps_different_prices_separate():
+    a = line(1, "10.00", "W-1")
+    b = line(1, "12.00", "W-1")
+    assert merge_lines([a, b, a]) == (line(2, "10.00", "W-1"), b)
+
+
+def test_merge_lines_order_of_first_appearance():
+    result = merge_lines([
+        line(1, "5.00", "B"), line(1, "1.00", "A"), line(2, "5.00", "B"),
+        line(1, "1.00", "C"),
+    ])
+    assert [(l.sku, l.quantity) for l in result] == [("B", 3), ("A", 1), ("C", 1)]
+
+
+def test_merge_lines_equal_prices_with_different_scale():
+    result = merge_lines([line(1, "10.0"), line(1, "10.00")])
+    assert len(result) == 1 and result[0].quantity == 2
+
+
+def test_merge_lines_returns_tuple_and_empty():
+    assert merge_lines([]) == ()
+    assert isinstance(merge_lines(iter([line()])), tuple)
+
+
+def test_merge_lines_does_not_mutate_input():
+    lines = [line(1), line(1)]
+    merge_lines(lines)
+    assert lines == [line(1), line(1)]
