+def list_numbers(directory: Path) -> list[str]:
+    """Return the sorted numbers of the invoices saved in `directory`.
+
+    Only `.json` files are considered; anything else is ignored.
+    """
+    return sorted(
+        path.stem for path in Path(directory).iterdir()
+        if path.is_file() and path.suffix == ".json"
+    )
+
