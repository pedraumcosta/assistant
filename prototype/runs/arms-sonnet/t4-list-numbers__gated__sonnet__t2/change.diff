+def test_list_numbers_sorted_and_ignores_non_json(tmp_path):
+    from invoicing.store import list_numbers
+    a = invoice(line(1, "1.00"))
+    save(a, tmp_path)
+    (tmp_path / "notes.txt").write_text("x")
+    (tmp_path / "b.json.bak").write_text("x")
+    (tmp_path / "subdir.json").mkdir()
+    import json
+    for n in ("Z-2", "A-1"):
+        (tmp_path / f"{n}.json").write_text(json.dumps({}))
+    assert list_numbers(tmp_path) == sorted([a.number, "Z-2", "A-1"])
