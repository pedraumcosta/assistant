+        (50, "450.00"),
+        (100, "900.00"),
+    ],
+)
+def test_line_total_quantity_discount(quantity, expected):
+    assert line_total(line(quantity, "10.00")) == Decimal(expected)
+
+
+def test_line_total_quantity_discount_rounds_once_half_even():
+    # 10 * 0.25 = 2.50; 5% off = 2.375 -> 2.38 (half-even on the line total)
+    assert line_total(line(10, "0.25")) == Decimal("2.38")
+    # 10 * 0.45 = 4.50; 5% off = 4.275 -> 4.28
+    assert line_total(line(10, "0.45")) == Decimal("4.28")
+    # 10 * 0.23 = 2.30; 5% off = 2.185 -> 2.18 (half-even)
+    assert line_total(line(10, "0.23")) == Decimal("2.18")
+
+
+def test_subtotal_uses_discounted_line_totals():
