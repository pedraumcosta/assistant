 from invoicing.rates import DISCOUNT_CODES, TAX_RATES
 
 
+QUANTITY_DISCOUNTS = (
+    (50, Decimal("0.10")),
+    (10, Decimal("0.05")),
+)
+
+
+def quantity_discount_rate(quantity: int) -> Decimal:
+    """The fraction taken off a line for buying `quantity` units."""
+    for threshold, rate in QUANTITY_DISCOUNTS:
+        if quantity >= threshold:
+            return rate
+    return Decimal("0")
+
+
 def line_total(line: LineItem) -> Decimal:
-    return round_cents(line.unit_price * line.quantity)
+    """Unit price times quantity, less any quantity discount, rounded once."""
+    gross = line.unit_price * line.quantity
+    rate = quantity_discount_rate(line.quantity)
+    return round_cents(gross * (1 - rate))
 
 
 def subtotal(invoice: Invoice) -> Decimal:
