+
+def test_merge_lines_combines_same_sku_and_price():
+    merged = merge_lines([line(2, "5.00"), line(3, "5.00")])
+    assert merged == (line(5, "5.00"),)
+
+
+def test_merge_lines_keeps_first_description():
+    merged = merge_lines([line(1, "5.00", description="First"), line(1, "5.00", description="Second")])
+    assert len(merged) == 1
+    assert merged[0].description == "First"
+
+
+def test_merge_lines_keeps_first_appearance_order():
+    a, b, c = line(1, "1.00", sku="A"), line(1, "2.00", sku="B"), line(1, "3.00", sku="C")
+    merged = merge_lines([a, b, c, line(4, "1.00", sku="A"), line(1, "2.00", sku="B")])
+    assert [(m.sku, m.quantity) for m in merged] == [("A", 5), ("B", 2), ("C", 1)]
+
+
+def test_merge_lines_different_price_stays_separate():
+    merged = merge_lines([line(1, "5.00"), line(1, "6.00"), line(2, "5.00")])
+    assert [(m.unit_price, m.quantity) for m in merged] == [
+        (Decimal("5.00"), 3),
+        (Decimal("6.00"), 1),
+    ]
+
+
+def test_merge_lines_equal_prices_with_different_exponent_merge():
+    merged = merge_lines([line(1, "5.0"), line(1, "5.00")])
+    assert len(merged) == 1 and merged[0].quantity == 2
+
+
+def test_merge_lines_returns_tuple_and_does_not_mutate_input():
+    lines = [line(1), line(1)]
+    result = merge_lines(lines)
+    assert isinstance(result, tuple)
+    assert len(lines) == 2 and lines[0].quantity == 1
+
+
+def test_merge_lines_empty():
+    assert merge_lines([]) == ()
