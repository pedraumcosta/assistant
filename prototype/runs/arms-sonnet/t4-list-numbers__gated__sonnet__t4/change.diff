+def list_numbers(directory: Path) -> list[str]:
+    """Return the sorted numbers of the invoices saved in ``directory``.
+
+    Only ``.json`` files count; anything else is ignored.
+    """
+    return sorted(
+        p.stem for p in Path(directory).iterdir()
+        if p.is_file() and p.suffix == ".json"
+    )
+
