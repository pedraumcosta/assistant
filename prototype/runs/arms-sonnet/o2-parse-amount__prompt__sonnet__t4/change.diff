+
+
+def test_parse_amount_thousands_separators():
+    assert parse_amount("1,234.50") == Decimal("1234.50")
+    assert parse_amount("1,234") == Decimal("1234")
+    assert parse_amount("12,345.6") == Decimal("12345.6")
+    assert parse_amount("123,456,789.01") == Decimal("123456789.01")
+    assert parse_amount(" 1,000 ") == Decimal("1000")
+    assert parse_amount("1,234.") == parse_amount("1234.")
+    assert parse_amount("-1,234.50") == Decimal("-1234.50")
+
+
+def test_parse_amount_keeps_exact_digits():
+    assert str(parse_amount("1,234.500")) == "1234.500"
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        ",",
+        ",123",
+        "1,23",
+        "1,2345",
+        "1234,567",
+        "1,234,56",
+        "1,,234",
+        "1,234,",
+        "1,234.5,6",
+        "1.234,50",
+        "1,234,5.00",
+        "12,34.50",
+        "1 ,234",
+        "1,234e2",
+        "1,234.5,",
+    ],
+)
+def test_parse_amount_rejects_malformed_commas(text):
