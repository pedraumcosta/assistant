+def test_merge_lines_combines_same_sku_and_price():
+    merged = merge_lines([line(2, "5.00"), line(3, "5.00", description="Other")])
+    assert merged == (line(5, "5.00"),)
+
+
+def test_merge_lines_keeps_first_appearance_order():
+    a, b = line(1, "1.00", "A"), line(1, "2.00", "B")
+    merged = merge_lines([a, b, line(2, "1.00", "A")])
+    assert merged == (line(3, "1.00", "A"), b)
+
+
+def test_merge_lines_different_price_stays_separate():
+    merged = merge_lines([line(1, "5.00"), line(1, "6.00"), line(1, "5.00")])
+    assert merged == (line(2, "5.00"), line(1, "6.00"))
+
+
+def test_merge_lines_equal_prices_with_different_scale():
+    assert merge_lines([line(1, "5.0"), line(1, "5.00")])[0].quantity == 2
+
+
+def test_merge_lines_empty_and_returns_tuple():
+    assert merge_lines([]) == ()
+    assert isinstance(merge_lines(iter([line()])), tuple)
+
