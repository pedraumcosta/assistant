+
+
+def test_parse_amount_thousands_separators():
+    assert parse_amount("1,234.50") == Decimal("1234.50")
+    assert parse_amount("1,234") == Decimal("1234")
+    assert parse_amount("12,345,678.9") == Decimal("12345678.9")
+    assert parse_amount(" 999,999.99 ") == Decimal("999999.99")
+    assert parse_amount("-1,234.50") == Decimal("-1234.50")
+
+
+def test_parse_amount_no_commas_unchanged():
+    assert parse_amount("1234.50") == Decimal("1234.50")
+    assert parse_amount("1234.567") == Decimal("1234.567")
+
+
+@pytest.mark.parametrize("bad", [
+    ",234", "1,23", "1,2345", "1234,567", "1,234,56", "1,,234", "1,234,",
+    "1.234,50", "1,234.5,6", "1.234,567", "1,234.567,890", "12,34.50",
+    "0,5", ",", "1,234e2", "a,bcd", "1 ,234", "1,234 567",
+])
+def test_parse_amount_rejects_malformed_commas(bad):
+    with pytest.raises(ValueError):
+        parse_amount(bad)
