+def quantity_discount_rate(quantity: int) -> Decimal:
+    """Fraction taken off a line for its quantity: 10% at 50+, 5% at 10+."""
+    if quantity >= 50:
+        return Decimal("0.10")
+    if quantity >= 10:
+        return Decimal("0.05")
+    return Decimal("0")
